@model IEnumerable<Btqn_lesson06.Models.BtqnEmployee>
@{
    ViewData["Title"] = "Danh Sách Sinh Viên";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary m-0">📋 Danh Sách Sinh Viên</h1>
        <a href="/BtqnEmployee/BtqnCreate" class="btn btn-outline-primary shadow">
            ➕ Thêm mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["Success"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive shadow-lg rounded-4 border">
        <table class="table table-bordered table-hover table-striped align-middle mb-0">
            <thead class="table-primary text-center">
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 20%;">👤 Họ Tên</th>
                    <th style="width: 12%;">📅 Ngày Sinh</th>
                    <th style="width: 18%;">✉️ Email</th>
                    <th style="width: 12%;">📞 Điện Thoại</th>
                    <th style="width: 10%;" class="text-end">💰 Lương</th>
                    <th style="width: 10%;">⚙️ Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td class="text-center text-muted">@emp.BtqnId</td>
                        <td class="fw-semibold">@emp.BtqnName</td>
                        <td class="text-center">@emp.BtqnBirthDay.ToString("dd/MM/yyyy")</td>
                        <td>@emp.BtqnEmail</td>
                        <td class="text-center">@emp.BtqnPhone</td>
                        <td class="text-end text-success fw-bold">@emp.BtqnSalary.ToString("N0") đ</td>
                        <td class="text-center">
                            @if (emp.BtqnStatus)
                            {
                                <span class="badge bg-success px-3 py-2">✔️ Đang làm</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">❌ Nghỉ việc</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
