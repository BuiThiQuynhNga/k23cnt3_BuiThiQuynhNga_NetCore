@model BuiThiQuynhNga_2310900075.Models.BtqnEmployee

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<h2 class="mb-4">Thêm Nhân Viên</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="BtqnCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="BtqnEmpName" class="form-label">Họ tên</label>
                <input asp-for="BtqnEmpName" class="form-control" placeholder="Nhập họ tên" />
                <span asp-validation-for="BtqnEmpName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BtqnEmpLevel" class="form-label">Chức vụ / Cấp bậc</label>
                <input asp-for="BtqnEmpLevel" class="form-control" placeholder="Nhập cấp bậc" />
                <span asp-validation-for="BtqnEmpLevel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BtqnEmpStartDate" class="form-label">Ngày bắt đầu</label>
                <input asp-for="BtqnEmpStartDate" class="form-control" type="date" />
                <span asp-validation-for="BtqnEmpStartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Trạng thái</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="BtqnEmpStatus" value="true" checked />
                    <label class="form-check-label">Hiển thị (Show)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="BtqnEmpStatus" value="false" />
                    <label class="form-check-label">Ẩn (Hide)</label>
                </div>
                <span asp-validation-for="BtqnEmpStatus" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Lưu thông tin" class="btn btn-success" />
                <a asp-action="BtqnIndex" class="btn btn-secondary ms-2">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
